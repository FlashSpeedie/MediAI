# ─── SUPABASE DATABASE ──────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → Database
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/database"

# ─── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Generate secret: run `openssl rand -base64 32` in terminal
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── GEMINI AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY="your-gemini-api-key"

# ─── APP ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── MEDICINE APIs (NO KEY NEEDED — both are free and open) ───────────────────
# OpenFDA: https://api.fda.gov — Official US FDA drug data
# RxNorm:  https://rxnav.nlm.nih.gov — NIH drug database
# These are called directly from the app — no API key required

# ─── GROQ AI ───────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY="your-groq-api-key"